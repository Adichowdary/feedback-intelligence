# Hindsight Memory Bank Configuration
HINDSIGHT_BANK_ID=feedback-intelligence
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=gpt-4o-mini
HINDSIGHT_LLM_API_KEY=sk-your-openai-api-key

# OpenAI API Key (Dual-Mode: Leave empty or dummy to use built-in TEMPR synthesis)
OPENAI_API_KEY=sk-your-openai-api-key

# Application Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Embedded Hindsight server (slow startup, loads ML models - requires a real API key)
# false = fast local mode (recommended for demo), true = full Hindsight memory pipeline
HINDSIGHT_EMBEDDED=false

# Optional: connect to a remote Hindsight instance instead of embedding one
# (e.g. your Hindsight Cloud instance URL) - takes precedence over HINDSIGHT_EMBEDDED
HINDSIGHT_URL=
